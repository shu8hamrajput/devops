# Example override file for local development
# Copy this to docker-compose.override.yml and modify as needed

version: '3.8'

services:
  backend:
    # Mount local code for development (optional)
    # volumes:
    #   - .:/app
    #   - /app/vendor
    environment:
      - PORT=8080

  frontend:
    build:
      args:
        - VITE_API_URL=http://localhost:8080

